+        private Vector3 MagicFlareDirection(int slot, float rate = 1f)
+        {
+            // GetMagicScrew(iFrame), with the source's even/odd slot sign.
+            int frame = (int)(Clock.WorldTimeMilliseconds / 40f);
+            frame = ((slot & 1) != 0 ? frame : -frame) + slot * 53731;
+            float a = (frame + 55555f) * 0.048f * rate;
+            float b = frame * 0.0613f * rate;
+            float c = (frame + 11111f) * 0.1113f * rate;
+            float dx = MathF.Sin(a) * MathF.Cos(b);
+            float dy = MathF.Sin(a) * MathF.Sin(b);
+            float dz = MathF.Cos(a);
+            float sa = MathF.Sin(c), ca = MathF.Cos(c);
+            return new Vector3(ca * dy - sa * dz,
+                sa * dy + ca * dz, dx);
+        }
