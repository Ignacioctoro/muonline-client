+        private void MoveFlareRing40(ref ClassicJoint j, float f,
+            ref ClassicMatrix3x4 matrix)
+        {
+            // Native uses a function-level static lMax, initialized once.
+            if (_nativeFlare40InitialLifetime < 0)
+                _nativeFlare40InitialLifetime = (int)j.LifeTime;
+            j.CreateTails = false;
+            j.NumTails = 0;
+            Vector3 previous = j.Position;
+            const float radius = 50f;
+            float azimuth = MathHelper.ToRadians(90f - j.Angle.Z);
+            for (int n = 0; n < ClassicJoint.MaxTailSegments; n++)
+            {
+                float theta = n * MathF.PI / 6f;
+                float rc = radius * MathF.Cos(theta);
+                float rs = radius * MathF.Sin(theta);
+                Vector3 point = new Vector3(rc * MathF.Cos(azimuth),
+                    rc * MathF.Sin(azimuth), rs);
+                float elapsed = _nativeFlare40InitialLifetime - j.LifeTime;
+                j.TargetPosition.X += j.Direction.X * elapsed * f;
+                j.TargetPosition.Y += j.Direction.Y * elapsed * f;
+                j.Position = j.TargetPosition + point;
+                matrix = ClassicMath.AngleMatrix(j.Angle);
+                AppendJointTailMoveA(ref j, matrix);
+            }
+            j.Position = previous;
+            j.Position.X += j.Direction.X * 12f * f;
+            j.Position.Y += j.Direction.Y * 12f * f;
+            j.TargetPosition = j.Position;
+            j.Scale *= MathF.Pow(1.1f, f);
+            j.Light = new Vector3(0.5f + R(64) / 255f,
+                0.5f + R(64) / 255f, 0.5f + R(128) / 255f);
+        }
+
+        private void MoveFlareOrbit(ref ClassicJoint j, float f)
+        {
+            float count;
+            Vector3 shift;
+            if (j.SubType == 6)
+            {
+                count = j.Direction.X + j.LifeTime *
+                    (j.Type == ClassicTextureIds.BitmapFlareBlue ? 0.8f : 0.5f);
+                float radius = MathF.Max((int)j.LifeTime, 1) * 2f;
+                shift = new Vector3(-MathF.Cos(count) * radius,
+                    MathF.Sin(count) * radius, 0f);
+            }
+            else if (j.SubType == 12)
+            {
+                count = (j.Direction.X + j.LifeTime) * 0.1f;
+                shift = new Vector3(-MathF.Cos(count) * 26f,
+                    MathF.Sin(count) * 26f - (90f - j.LifeTime) * 0.3f, 0f);
+            }
+            else
+            {
+                count = (j.Direction.X + j.LifeTime) * 0.1f;
+                float radius = MathF.Max((int)(j.LifeTime + 40f), 10) * 0.65f;
+                shift = new Vector3(-MathF.Cos(count) * radius,
+                    MathF.Sin(count) * radius, 0f);
+            }
+            j.TargetPosition.X += j.Direction.Y * f;
+            j.TargetPosition.Y += j.Direction.Z * f;
+            float rot = MathHelper.ToRadians(90f - j.Angle.Z);
+            j.Position = new Vector3(
+                shift.X * MathF.Sin(rot) + j.TargetPosition.X,
+                shift.X * MathF.Cos(rot) + j.TargetPosition.Y,
+                shift.Y + j.TargetPosition.Z);
+        }
