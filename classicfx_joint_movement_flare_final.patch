+        private bool MoveFlareClassicJoint(ref ClassicJoint j, int slot,
+            ClassicFxHandle handle, float f, ref ClassicMatrix3x4 matrix)
+        {
+            switch (j.SubType)
+            {
+                case 0: case 10: case 18:
+                {
+                    float count = j.PKKey != -1 && j.PKKey != 0
+                        ? (j.Direction.Y + j.LifeTime) / j.PKKey
+                        : j.SubType == 18
+                            ? (j.Direction.Y + j.LifeTime * 2f) * 0.1f
+                            : (j.Direction.Y + j.LifeTime) * 0.1f;
+                    // Native uses powf(-1, FPS_ANIMATION_FACTOR). Preserve
+                    // frame-factor sign without NaN for non-integer factors.
+                    if (j.PKKey == -1 && j.SubType == 18 && j.Skill == 1)
+                        count *= -1f;
+                    j.Position.X = j.TargetPosition.X + MathF.Cos(count) * j.Velocity;
+                    j.Position.Y = j.TargetPosition.Y - MathF.Sin(count) * j.Velocity;
+                    if (j.SubType == 0) j.Position.Z += j.Direction.Z * f;
+                    else if (j.SubType == 10) j.Position.Z -= j.Direction.Z * f;
+                    else
+                    {
+                        j.Position.Z += j.Direction.Z * 1.1f * f;
+                        j.Velocity += f * 0.1f;
+                        j.Scale += f * 0.2f;
+                    }
+                    break;
+                }
+                case 20:
+                    if (!TryGetOwnerBonePosition(j.Target, 33, out j.Position))
+                        return false;
+                    break;
+                case 14: case 15:
+                {
+                    if (j.Target.HasOwner)
+                    {
+                        float count = j.Direction.Y * 0.1f;
+                        if (j.SubType == 15) count = -count;
+                        j.Position.X = j.TargetPosition.X + MathF.Cos(count) * j.Velocity;
+                        j.Position.Y = j.TargetPosition.Y - MathF.Sin(count) * j.Velocity;
+                        j.Position.Z += j.Direction.Z * f;
+                        if (j.LifeTime < 20f) j.Velocity += 5f * f;
+                        j.Scale += f;
+                        j.Direction.Y += 4f * f;
+                        j.Direction.Z += ((R(200) + 200f) / 100f) * f;
+                    }
+                    break;
+                }
+                case 2: case 21: case 22: case 24: case 50: case 51:
+                    if (j.SubType == 51)
+                    {
+                        j.Direction.Z += 10f * f;
+                        j.Position.X = j.TargetPosition.X;
+                        j.Position.Y = j.TargetPosition.Y;
+                        j.Position.Z += j.Direction.Z * f;
+                    }
+                    if (j.LifeTime <= 25f || j.SubType == 50)
+                    {
+                        j.Direction.Z += 5f * f;
+                        j.Position.X = j.TargetPosition.X;
+                        j.Position.Y = j.TargetPosition.Y;
+                        j.Position.Z += j.Direction.Z * f;
+                    }
+                    break;
+                case 41:
+                    if (j.LifeTime <= 20f)
+                    {
+                        j.Direction.Z += f;
+                        j.Position.X = j.TargetPosition.X;
+                        j.Position.Y = j.TargetPosition.Y;
+                        j.Position.Z += j.Direction.Z * f;
+                        j.Light *= MathF.Pow(1f / 1.1f, f);
+                    }
+                    AddClassicTerrainLight(j.Position.X, j.Position.Y, j.Light, 1f);
+                    break;
+                case 42:
+                    if (!TryGetOwnerSnapshot(j.Target, out _)) return false;
+                    j.Angle.Z += 15f * f;
+                    j.LifeTime = 100f;
+                    matrix = ClassicMath.AngleMatrix(j.Angle);
+                    j.Position = j.StartPosition + ClassicMath.VectorRotate(
+                        j.Direction, matrix);
+                    if (((int)j.Angle.Z % 45) == 0 && R(100) <= 50)
+                        CreateJointFpsChecked(ClassicTextureIds.BitmapFlare,
+                            j.Position, j.Position, Vector3.Zero, 41, scale: j.Scale);
+                    AddClassicTerrainLight(j.TargetPosition.X,
+                        j.TargetPosition.Y, j.Light, 2f);
+                    break;
+                case 19:
+                    if (j.LifeTime <= 25f)
+                    {
+                        j.Direction.Z -= 5f * f;
+                        j.Position.X = j.TargetPosition.X;
+                        j.Position.Y = j.TargetPosition.Y;
+                        j.Position.Z += j.Direction.Z * f;
+                    }
+                    break;
+                case 40:
+                    MoveFlareRing40(ref j, f, ref matrix);
+                    break;
+                case 4: case 6: case 12:
+                    MoveFlareOrbit(ref j, f);
+                    break;
+                case 5:
+                    j.Direction.Z -= 60f * f;
+                    j.Position.X = j.TargetPosition.X;
+                    j.Position.Y = j.TargetPosition.Y;
+                    j.Position.Z += j.Direction.Z * f;
+                    j.Scale = R(4) + 6f;
+                    break;
+                case 7: case 11: case 25: case 45: case 46: case 47:
+                    if (!MoveFlareMagic(ref j, slot, handle)) return false;
+                    break;
+                case 8:
+                    j.Position = j.StartPosition + ClassicMath.VectorRotate(
+                        new Vector3(0f, -50f, 0f),
+                        ClassicMath.AngleMatrix(j.TargetPosition));
+                    matrix = ClassicMath.AngleMatrix(j.Angle);
+                    j.TargetPosition.Z += 10f;
+                    break;
+                case 9:
+                    matrix = ClassicMath.AngleMatrix(j.Angle);
+                    for (int k = 0; k < Math.Clamp(j.MaxTails, 0, 200); k++)
+                    {
+                        j.Position += j.StartPosition;
+                        AppendJointTailMoveA(ref j, matrix);
+                    }
+                    break;
+                case 13:
+                    if (j.LifeTime <= 25f)
+                    {
+                        j.Direction.Z += f;
+                        j.Position.X = j.TargetPosition.X;
+                        j.Position.Y = j.TargetPosition.Y;
+                        j.Position.Z += j.Direction.Z * f;
+                    }
+                    break;
+                case 17:
+                    if (JointFlareOwnerActionCancelsResolver?.Invoke(j.Target) == true)
+                        j.LifeTime -= 10f * f;
+                    else
+                    {
+                        j.Direction.X += MathF.Sin(R(360) * 0.1f) * 4f * f;
+                        j.Direction.Y += MathF.Cos(R(360) * 0.1f) * 4f * f;
+                        j.Direction.Z += j.Velocity * f;
+                        j.Position = j.TargetPosition + j.Direction;
+                    }
+                    if (j.LifeTime < 12f) j.Light *= MathF.Pow(1f / 1.3f, f);
+                    break;
+                case 16:
+                    if (j.Target.HasOwner)
+                    {
+                        if (!TryGetOwnerPosition(j.Target, out Vector3 anchor16))
+                            return false;
+                        ShiftFlareTails(ref j, j.TargetPosition - anchor16);
+                        j.TargetPosition = anchor16;
+                        if (j.LifeTime < 20f) j.Light *= MathF.Pow(1f / 1.1f, f);
+                        else if (j.LifeTime < 40f) j.Light = new Vector3(0.25f);
+                        else j.Light *= MathF.Pow(1.04f, f);
+                    }
+                    break;
+                case 23:
+                    MoveFlare23(ref j, f, ref matrix);
+                    break;
+                case 43:
+                    if (!TryGetOwnerPosition(j.Target, out Vector3 flare43)) return false;
+                    j.LifeTime = 100f;
+                    if (Random.FpsCheck(3, Clock))
+                    {
+                        Vector3 p = flare43 + new Vector3(
+                            (R(60) - 30f) * f, (R(60) - 30f) * f, 30f * f);
+                        CreateJoint(ClassicTextureIds.BitmapFlare,
+                            p, p, j.Angle, 44, j.Target, j.Scale,
+                            priorColor: j.Light);
+                    }
+                    break;
+                case 44:
+                    if (!TryGetOwnerSnapshot(j.Target, out _)) return false;
+                    if (j.LifeTime <= 20f)
+                    {
+                        j.Direction.Z += f;
+                        j.Position.X = j.TargetPosition.X;
+                        j.Position.Y = j.TargetPosition.Y;
+                        j.Position.Z += j.Direction.Z * f;
+                        j.Light *= MathF.Pow(1f / 1.05f, f);
+                        CreateSprite(ClassicTextureIds.BitmapPinLight,
+                            j.Position, 1.5f, j.Light);
+                        CreateSprite(ClassicTextureIds.BitmapPinLight,
+                            j.Position, 0.5f, j.Light);
+                        if (j.Position.Z >= 400f) return false;
+                    }
+                    break;
+                default:
+                    // Native has no per-subtype movement case for 1,3 etc.
+                    break;
+            }
+            // Native Fade after type branch; subtype 14/15/16 included.
+            if ((j.SubType != 5 && j.SubType != 7 && j.SubType != 11) &&
+                j.LifeTime < 10f)
+                j.Light *= MathF.Pow(1f / 1.3f, f);
+            if ((j.SubType == 0 || j.SubType == 10 || j.SubType == 18) &&
+                j.Scale < 40f &&
+                JointFlareOwnerMovingOrAttackingResolver?.Invoke(j.Target) == true)
+            {
+                j.SubType = 1;
+                j.CreateTails = false;
+                j.LifeTime = MathF.Min(j.LifeTime, 10f);
+            }
+            return true;
+        }
