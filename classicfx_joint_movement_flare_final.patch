+        private bool MoveFlarePlusJoint(ref ClassicJoint j, int slot,
+            ClassicFxHandle handle, float f, ref ClassicMatrix3x4 matrix)
+        {
+            switch (j.SubType)
+            {
+                case 5: case 16: case 6:
+                {
+                    if (j.SubType == 6 && !j.Target.HasOwner)
+                        return false;
+                    float limit = j.SubType == 6 ? 30f : 25f;
+                    if (j.LifeTime >= limit)
+                    {
+                        j.Angle.Z -= 10f * f;
+                        j.Position.Z += 2.5f * f;
+                    }
+                    if (j.SubType == 6 || j.LifeTime < limit)
+                    {
+                        j.Velocity = MathF.Min(30f, j.Velocity + 5f * f);
+                        float oldAngle = j.Angle.Z;
+                        Vector3 target = j.TargetPosition;
+                        if (j.SubType == 6 || j.SubType == 16)
+                        {
+                            if (!TryGetOwnerPosition(j.Target, out target)) return false;
+                            if (j.SubType == 6) target.Z += 150f * f;
+                        }
+                        float distance = MoveJointHummingA(ref j.Angle,
+                            j.Position, target, j.Velocity, f);
+                        if (distance <= 70f &&
+                            MathF.Abs(oldAngle - j.Angle.Z) > 20f &&
+                            j.Velocity >= 20f)
+                            j.Velocity -= (j.SubType == 5 ? 5f : 10f) * f;
+                        if (j.LifeTime < (j.SubType == 6 ? 15f : 10f))
+                        {
+                            float light = j.Light.X * MathF.Pow(1f / 1.2f, f);
+                            j.Light = new Vector3(light);
+                        }
+                    }
+                    Vector3 terrainLight;
+                    float range;
+                    if (j.SubType == 16)
+                    {
+                        terrainLight = Vector3.One;
+                        range = 1f;
+                    }
+                    else
+                    {
+                        float lum = (R(4) + 8f) * 0.03f;
+                        terrainLight = j.SubType == 5
+                            ? new Vector3(lum * 0.4f, lum * 0.8f, lum * 0.4f)
+                            : new Vector3(lum * 0.4f, lum, lum * 0.8f);
+                        range = 2f;
+                    }
+                    AddClassicTerrainLight(j.Position.X, j.Position.Y,
+                        terrainLight, range);
+                    return true;
+                }
+                case 7:
+                    j.Position.X = j.StartPosition.X +
+                        MathF.Sin(j.LifeTime / 2.5f) * j.Direction.X;
+                    j.Position.Y = j.StartPosition.Y;
+                    j.Position.Z += j.Velocity * f;
+                    j.Velocity -= 0.1f * f;
+                    j.Direction.X -= 0.1f * f;
+                    if (j.LifeTime < 15f)
+                        j.Light *= MathF.Pow(1f / 1.2f, f);
+                    return true;
+                case 8: case 9:
+                    if (!TryGetOwnerPosition(j.Target, out j.Position)) return false;
+                    if (j.SubType == 8) j.Position.Z = 300f;
+                    else j.Position.Z += j.MultiUse * f;
+                    return true;
+                case 12: case 13: case 14: case 15: case 17: case 18:
+                    if (!TryGetOwnerSnapshot(j.Target, out _)) return false;
+                    if (j.SubType == 17)
+                        j.Light = new Vector3(1f, 1f, 0.2f);
+                    else if (j.SubType == 14)
+                    {
+                        CreateSprite(ClassicTextureIds.BitmapSpark + 1,
+                            j.Position, 5f, j.Light);
+                        CreateParticleFpsChecked(ClassicTextureIds.BitmapSmoke,
+                            j.Position, j.Angle, j.Light, 34, 1f);
+                        CreateParticleFpsChecked(ClassicTextureIds.BitmapSmoke,
+                            j.Position, j.Angle, j.Light, 35, 1f);
+                        j.Light = new Vector3(0.7f, 0.3f, 0.3f);
+                        CreateParticleFpsChecked(ClassicTextureIds.BitmapSpark + 1,
+                            j.Position, j.Angle, j.Light, 10, 4f);
+                        j.Light = new Vector3(1f, 1f, 0.2f);
+                    }
+                    else if (j.SubType == 15)
+                    {
+                        for (int i = 0; i < 2; i++)
+                            CreateParticleFpsChecked(ClassicTextureIds.BitmapShiny,
+                                j.Position, j.Angle, j.Light, 3, 0.5f);
+                    }
+                    if (j.LifeTime < 15f)
+                        j.Light *= MathF.Pow(1f / 1.2f, f);
+                    if (j.SubType != 18)
+                    {
+                        float lum = (R(4) + 8f) * 0.03f;
+                        AddClassicTerrainLight(j.Position.X, j.Position.Y,
+                            new Vector3(lum * 0.4f, lum, lum * 0.8f), 2f);
+                    }
+                    return true;
+                case 19: case 20:
+                    return MoveFlarePlusTriplet(ref j, f, ref matrix, false);
+                default:
+                    return MoveFlarePlusTriplet(ref j, f, ref matrix, true);
+            }
+        }
+
+        private bool MoveFlarePlusTriplet(ref ClassicJoint j, float f,
+            ref ClassicMatrix3x4 matrix, bool nativeDefault)
+        {
+            if (!TryGetOwnerSnapshot(j.Target, out ClassicFxOwnerSnapshot owner))
+            {
+                if (!nativeDefault) return false;
+                j.LifeTime = -1f;
+                j.Position = j.TargetPosition;
+                j.Position.Z += 50f * f;
+                return true;
+            }
+            Vector3? start = JointFlareOwnerStartPositionResolver?.Invoke(j.Target);
+            if (!start.HasValue)
+                return false; // Native OBJECT::StartPosition is not root Position.
+            Vector3 delta = (owner.Position - start.Value) / 3f;
+            j.TargetPosition = start.Value;
+            matrix = ClassicMath.AngleMatrix(j.Angle);
+            Vector3 angle = j.Angle;
+            if (nativeDefault)
+            {
+                Vector3? head = JointFlareOwnerHeadAngleResolver?.Invoke(j.Target);
+                if (!head.HasValue) return false;
+                angle = head.Value;
+                angle.Y += (j.Velocity - 90f) * f;
+            }
+            else
+            {
+                // In original 19/20 Angle[] is uninitialized; the old C++
+                // read is undefined. Use the existing joint angle as a
+                // deterministic input instead of reproducing undefined data.
+                angle = j.Angle;
+            }
+            for (int n = 0; n < 3; n++)
+            {
+                if (nativeDefault || j.SubType == 19)
+                    angle.Y += 30f * f;
+                j.TargetPosition += delta;
+                Vector3 rotation = ClassicMath.VectorRotate(
+                    j.Direction, ClassicMath.AngleMatrix(angle));
+                j.Position = j.TargetPosition + rotation;
+                if (j.NumTails < j.MaxTails - 1 || j.Skill != 0)
+                    AppendJointTailMoveA(ref j, matrix);
+            }
+            if (nativeDefault && j.LifeTime < 15f)
+                j.Light *= MathF.Pow(1f / 1.5f, f);
+            return true;
+        }
     }
 }
