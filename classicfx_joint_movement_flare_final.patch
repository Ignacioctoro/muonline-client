+        private bool MoveFlareJointFull(ref ClassicJoint j, int slot, ClassicFxHandle handle)
+        {
+            float f = Clock.FrameFactor;
+            if (f <= 0f) return true;
+            ClassicMatrix3x4 matrix = ClassicMath.AngleMatrix(j.Angle);
+            // Native common pre-switch excludes BITMAP_FLARE/BLUE subtype 1
+            // and BITMAP_FLARE subtype 42, NOT BITMAP_FLARE+1.
+            bool skipMove = (j.SubType == 1 &&
+                (j.Type == ClassicTextureIds.BitmapFlare ||
+                 j.Type == ClassicTextureIds.BitmapFlareBlue)) ||
+                 (j.Type == ClassicTextureIds.BitmapFlare && j.SubType == 42);
+            if (!skipMove && j.Velocity != 0f)
+                j.Position += ClassicMath.VectorRotate(
+                    new Vector3(0f, -j.Velocity, 0f), matrix) * f;
+
+            bool alive = j.Type == ClassicTextureIds.BitmapFlare + 1
+                ? MoveFlarePlusJoint(ref j, slot, handle, f, ref matrix)
+                : MoveFlareClassicJoint(ref j, slot, handle, f, ref matrix);
+            if (!alive) return false;
+            // The native post-switch CreateTail uses Matrix from entry,
+            // unless subtype branch updates it via AngleMatrix.
+            if (j.CreateTails)
+                AppendJointTailMoveA(ref j, matrix);
+            j.LifeTime -= f;
+            return j.LifeTime >= 0f;
+        }
