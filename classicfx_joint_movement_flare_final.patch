+        private static void ShiftFlareTails(ref ClassicJoint j, Vector3 oldMinusNew)
+        {
+            if (j.Tails == null) return;
+            int count = Math.Clamp(j.NumTails, 0, ClassicJoint.MaxTailSegments);
+            for (int n = count - 1; n >= 0; n--)
+                for (int k = 0; k < ClassicJoint.VerticesPerTail; k++)
+                    j.Tails[n * 4 + k] -= oldMinusNew;
+        }
