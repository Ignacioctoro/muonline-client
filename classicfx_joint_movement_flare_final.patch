+        private bool MoveFlareMagic(ref ClassicJoint j, int slot,
+            ClassicFxHandle handle)
+        {
+            if (!TryGetOwnerSnapshot(j.Target, out ClassicFxOwnerSnapshot owner))
+                return false;
+            bool usesStart = j.SubType == 11 || j.SubType == 25;
+            Vector3 ownerBase = owner.Position;
+            if (usesStart)
+            {
+                Vector3? ownerStart = JointFlareOwnerStartPositionResolver?.Invoke(j.Target);
+                if (!ownerStart.HasValue) return false;
+                ownerBase = ownerStart.Value;
+            }
+            float fLife = j.LifeTime * 40f / 30f;
+            float pos = usesStart
+                ? fLife < 20f ? fLife * 4f : fLife + 60f
+                : fLife < 10f ? fLife * 7f : fLife + 60f;
+            float divisor = 30f + j.MultiUse;
+            if (MathF.Abs(divisor) < 0.00001f)
+                return false; // Native division by zero is invalid.
+            pos = pos / divisor * 30f;
+            if ((int)j.LifeTime == 30)
+                JointFlareMeteoriteSoundRequested?.Invoke();
+            float circle = usesStart
+                ? MathF.Min(MathF.Max(0f, fLife - 10f) * 5f, 150f)
+                : MathF.Min(MathF.Max(0f, 40f - fLife) * 15f, 150f);
+            Vector3 dir = MagicFlareDirection(slot,
+                j.SubType == 11 ? 1.5f : 1f);
+            Vector3 onCircle = j.TargetPosition + dir * circle;
+            int frame = (int)(Clock.WorldTimeMilliseconds / 40f);
+            frame = ((slot & 1) != 0 ? frame : -frame) + slot * 53731;
+            for (int k = 0; k < 3; k++)
+            {
+                float jitter = 25f * MathF.Cos(
+                    (slot * 51231f + k * 3711f + frame / 10) * 0.01f);
+                float b = k == 0 ? ownerBase.X : k == 1 ? ownerBase.Y : ownerBase.Z;
+                float p = k == 0 ? onCircle.X : k == 1 ? onCircle.Y : onCircle.Z;
+                p = (pos * p + (100f - pos) * (b + jitter)) * 0.01f;
+                if (k == 0) j.Position.X = p;
+                else if (k == 1) j.Position.Y = p;
+                else j.Position.Z = p;
+            }
+            if (!usesStart) j.Position.Z += 100f;
+            Vector3 light = j.SubType == 11
+                ? new Vector3(0.3f, 0.3f, 0.5f)
+                : j.SubType == 25 ? new Vector3(0.9f, 0.4f, 0.6f)
+                : new Vector3(0.5f, 0.5f, 1f);
+            if (usesStart && j.Skill == 1)
+                JointFlareSetArrowOwnerPositionRequested?.Invoke(j.Target, j.Position);
+            if (j.SubType == 45 && j.LifeTime <= 1f)
+            {
+                JointSecondaryEffectRequested?.Invoke(handle,
+                    "MODEL_CHANGE_UP_EFF", owner.Position,
+                    owner.Angle, owner.Light, 1, 1f);
+                JointSecondaryEffectRequested?.Invoke(handle,
+                    "MODEL_CHANGE_UP_CYLINDER", owner.Position,
+                    owner.Angle, owner.Light, 1, 1f);
+            }
+            if (j.SubType != 47)
+            {
+                CreateSprite(ClassicTextureIds.BitmapShiny + 1,
+                    j.Position, (R(2) + 8f) * 0.10f, light, j.Target, R(360));
+                CreateSprite(ClassicTextureIds.BitmapLight,
+                    j.Position, (R(2) + 8f) * 0.18f, light, j.Target, R(360));
+                CreateSprite(ClassicTextureIds.BitmapLight,
+                    j.Position, (R(2) + 8f) * 0.18f, light, j.Target, R(360));
+            }
+            if (j.SubType != 11 && j.SubType != 45 && j.SubType != 46 &&
+                j.SubType != 47 && (int)j.LifeTime == 1)
+                CreateParticleFpsChecked(ClassicTextureIds.BitmapExplotion,
+                    j.Position, Vector3.Zero, Vector3.One, 1, 0.6f);
+            return true;
+        }
+
+        private void MoveFlare23(ref ClassicJoint j, float f,
+            ref ClassicMatrix3x4 matrix)
+        {
+            if (j.LifeTime >= 20f) return;
+            j.Velocity = 200f;
+            if (j.LifeTime < 8f)
+            {
+                j.Velocity = 0f;
+                matrix = ClassicMath.AngleMatrix(j.HeadAngle);
+                AppendJointTailMoveA(ref j, matrix);
+                return;
+            }
+            // The original loop count is Direction.Z. Respect the fixed pool
+            // capacity to prevent exhausted tails becoming an unbounded loop.
+            int limit = Math.Clamp((int)MathF.Ceiling(MathF.Max(0f, j.Direction.Z)),
+                0, ClassicJoint.MaxTailSegments);
+            for (int i = 0; i < limit; i++)
+            {
+                j.Direction.Y += 1.5f * f;
+                switch ((int)j.MultiUse)
+                {
+                    case 0: j.HeadAngle.X += 3f * f; j.HeadAngle.Z -= j.Direction.Y * f; break;
+                    case 1: j.HeadAngle.X -= 3f * f; j.HeadAngle.Z -= j.Direction.Y * f; break;
+                    case 2: j.HeadAngle.X += 3f * f; j.HeadAngle.Z += j.Direction.Y * f; break;
+                    case 3: j.HeadAngle.X -= 3f * f; j.HeadAngle.Z += j.Direction.Y * f; break;
+                    case 4: j.HeadAngle.Z -= j.Direction.Y * f; break;
+                    case 5: j.HeadAngle.X -= j.Direction.Y * f; break;
+                }
+                j.Direction.Y = MathF.Min(j.Direction.Y, 15f);
+                matrix = ClassicMath.AngleMatrix(j.HeadAngle);
+                Vector3 delta = ClassicMath.VectorRotate(
+                    new Vector3(0f, -j.Velocity * f, 0f), matrix);
+                j.Position = j.StartPosition + delta;
+                AppendJointTailMoveA(ref j, matrix);
+                if (j.NumTails >= j.MaxTails - 1)
+                {
+                    j.Velocity = 0f;
+                    break;
+                }
+            }
+            j.Direction.Z += 4f * f;
+        }
