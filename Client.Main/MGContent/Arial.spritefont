<?xml version="1.0" encoding="utf-8"?>
<XnaContent xmlns:Graphics="Microsoft.Xna.Framework.Content.Pipeline.Graphics">
  <Asset Type="Graphics:FontDescription">

    <FontName>Fonts/arial.ttf</FontName>

    <Size>25</Size>

    <Spacing>0</Spacing>

    <UseKerning>true</UseKerning>

    <Style>Regular</Style>

    <DefaultCharacter>?</DefaultCharacter>

    <CharacterRegions>
      <!-- ASCII -->
      <CharacterRegion>
        <Start> </Start>
        <End>~</End>
      </CharacterRegion>

      <!-- Latin-1: incluye ¡ ¿ ñ á é í ó ú ü etc. -->
      <CharacterRegion>
        <Start>¡</Start>
        <End>ÿ</End>
      </CharacterRegion>

      <!-- Latin Extended-A -->
      <CharacterRegion>
        <Start>Ā</Start>
        <End>ſ</End>
      </CharacterRegion>
    </CharacterRegions>

  </Asset>
</XnaContent>